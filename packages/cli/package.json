{
  "name": "@ai-crew-suite/cli",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "crew": "./dist/bin/crew.js"
  },
  "exports": {
    "./config/eslint": "./dist/bin/commands/lint/lib/factory.js",
    "./storybook/mocks": "./src/bin/commands/storybook/lib/mockUtils.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn clean && rollup --config rollup.config.ts --configPlugin typescript",
    "clean": "rimraf dist",
    "lint": "node ./dist/bin/crew.js lint",
    "publish": "npm publish",
    "test": "yarn test:run",
    "test:unit": "vitest run --config ./vitest.config.ts",
    "test:unit:coverage": "vitest run --coverage --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/core-components": "^0.18.13",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/eslint-plugin": "backstage:^",
    "@backstage/test-utils": "^1.7.21",
    "@backstage/theme": "^0.7.3",
    "@material-ui/core": "^4.12.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "react": "catalog:react",
    "react-dom": "catalog:react-dom",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.0",
    "tsc": "^2.0.4",
    "tsx": "^4.23.13",
    "typescript": "catalog:typescript",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vite-plugin-tsconfig-paths": "^1.4.1",
    "vitest": "catalog:vitest"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:node-types",
    "rollup": "^4.63.1"
  }
}
